# Copy to .env.local and fill in real values
# setup.sh generates .env.local automatically

DATABASE_URL="postgresql://rproxy:CHANGE_ME@localhost:5432/rproxy"
JWT_SECRET="CHANGE_ME_256_bit_random_secret"
JWT_REFRESH_SECRET="CHANGE_ME_256_bit_random_refresh_secret"
NEXTAUTH_URL="http://localhost:3000"
NODE_ENV="production"
CRON_SECRET="CHANGE_ME_any_random_string"

# API Gateway — Redis backs per-customer rate-limit/quota counters.
REDIS_URL="redis://127.0.0.1:6379"
# Shared secret nginx's auth_request subrequest presents to
# /api/gateway/auth-check so the endpoint can't be hit usefully from
# anywhere but nginx itself.
GATEWAY_AUTH_SECRET="CHANGE_ME_any_random_string"
# If Redis is briefly unreachable: "true" lets customer traffic through
# without rate/quota enforcement (nginx's static limit_req ceiling still
# applies); "false" fails closed and blocks gateway traffic until Redis
# recovers.
GATEWAY_REDIS_FAIL_OPEN="true"
